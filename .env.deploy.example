# ==============================================================================
# LOCKMYSEAT DEPLOYMENT CONFIGURATION & CREDENTIALS
# ==============================================================================

# 1. SUPABASE (Managed PostgreSQL Cloud Database)
# ------------------------------------------------------------------------------
# Go to https://supabase.com -> Project Settings -> Database -> Connection string
# Use "URI" (or "Transaction pooler" / "Session pooler" on port 5432 or 6543)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

# Or if you provide the direct PostgreSQL connection URI:
DATABASE_URL=

# 2. RENDER (Plain Java 21 Web Service)
# ------------------------------------------------------------------------------
# We will deploy the Plain Java backend on Render as a Web Service.
# To deploy via Render API or CLI, provide:
RENDER_API_KEY=
# (Optional) If you already created a service on Render:
RENDER_SERVICE_ID=

# 3. VERCEL (Next.js Frontend Hosting)
# ------------------------------------------------------------------------------
# To deploy the Next.js frontend to Vercel via CLI/API:
# Get token at: https://vercel.com/account/tokens
VERCEL_TOKEN=
# (Optional) Org / Team ID if deploying under a team:
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# 4. GITHUB REPOSITORY (Recommended for continuous deployment on Render & Vercel)
# ------------------------------------------------------------------------------
# If you want Render and Vercel to auto-deploy from a GitHub repo:
# (e.g. https://github.com/your-username/LockMySeat)
GITHUB_REPO_URL=
GITHUB_TOKEN=
